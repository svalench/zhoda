# Zhoda council config — copy to zhoda.yaml
council:
  - deepseek/deepseek-chat-v3:free
  - google/gemma-3-27b:free
  - qwen/qwen3-32b:free
  - meta-llama/llama-4-scout:free
chairman: google/gemini-3-pro        # appeals only (paid, optional)

rounds_cap: 4
stability_rounds: 2                  # consensus must persist 2 rounds
faction_threshold: 0.82              # TODO(calibrate): on bench data
ambiguity_threshold: 0.6             # TODO(calibrate): smart elicitation
router_confidence_threshold: 0.7     # below -> escalate UP one protocol
devils_advocate: true

escalation:
  enabled: false                     # true = paid appeal ladder
  ladder: [free, mid, frontier]

budget_per_question_usd: 0.0         # hard cap; 0 = free models only
